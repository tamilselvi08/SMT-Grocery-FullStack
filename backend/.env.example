# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/smt_grocery

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin (used by seed script to create the first admin account)
ADMIN_NAME=SMT Admin
ADMIN_EMAIL=admin@smtgrocery.com
ADMIN_PASSWORD=Admin@12345

# Payment gateway (integration-ready; leave blank until you have real keys)
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
